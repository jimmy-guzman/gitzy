{
  "name": "gitzy",
  "version": "7.2.2",
  "description": "Conventional commits and branch CLI",
  "keywords": [
    "cli",
    "conventional commits",
    "git"
  ],
  "homepage": "https://github.com/jimmy-guzman/gitzy",
  "bugs": "https://github.com/jimmy-guzman/gitzy/issues",
  "license": "MIT",
  "author": "jimmy-guzman @jimmy-guzman",
  "repository": "git+https://github.com/jimmy-guzman/gitzy.git",
  "bin": "./dist/run.mjs",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "precheck": "pnpm build",
    "check": "pnpm run \"/^(knip|lint|coverage)$/\"",
    "coverage": "vitest run --coverage",
    "gitzy": "tsx src/run.ts",
    "knip": "knip",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "prepack": "pnpm build && clean-pkg-json",
    "prepare": "husky",
    "test": "vitest"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@leeoniya/ufuzzy": "1.0.19",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "clean-pkg-json": "2.0.0",
    "commander": "15.0.0",
    "commitlint": "21.2.3",
    "cspell": "10.3.6",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "knip": "6.41.0",
    "lilconfig": "3.1.3",
    "lint-staged": "17.6.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "0.3.25",
    "tinyexec": "1.3.1",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "ultracite": "8.0.0",
    "unrun": "0.3.1",
    "valibot": "1.5.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css,scss,less,vue,svelte,astro,html,md,mdx,yaml,yml,graphql,gql}": [
      "pnpm exec ultracite fix",
      "cspell --no-must-find-files --no-progress"
    ]
  },
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "packageManager": "pnpm@12.13.0"
}
